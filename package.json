{
  "name": "@idcesares/the-membrane-palette",
  "version": "2.1.0",
  "private": true,
  "description": "The Membrane Palette — a token-based design system and framework-free CSS component library where human warmth meets digital precision.",
  "author": "Isaac D'Césares <isaac.dcesares@gmail.com>",
  "license": "MIT",
  "homepage": "https://membrane-palette.dcesares.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idcesares/The-Membrane-Palette.git"
  },
  "bugs": {
    "url": "https://github.com/idcesares/The-Membrane-Palette/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg",
    "component-library",
    "css-components",
    "css-custom-properties",
    "membrane-palette",
    "dark-mode",
    "accessibility",
    "wcag",
    "oklch",
    "llms-txt"
  ],
  "exports": {
    ".": "./membrane.css",
    "./membrane.css": "./membrane.css",
    "./tokens": "./tokens/design-tokens.css",
    "./base": "./tokens/base.css",
    "./components": "./components/membrane-components.css",
    "./components.js": "./components/membrane.js",
    "./manifest.json": "./components/manifest.json",
    "./tokens.json": "./tokens/membrane.tokens.json",
    "./tailwind": "./tokens/membrane-tailwind.css",
    "./tokens.resolved.json": "./tokens/tokens.resolved.json",
    "./fonts.css": "./fonts/fonts.css",
    "./types": "./components/membrane.d.ts"
  },
  "files": [
    "membrane.css",
    "tokens/design-tokens.css",
    "tokens/base.css",
    "tokens/membrane.tokens.json",
    "tokens/membrane-tailwind.css",
    "tokens/tokens.resolved.json",
    "components/",
    "llms.txt",
    "fonts/",
    "brand/"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:components": "node scripts/build-components.mjs",
    "build:system": "npm run build:tokens && npm run build:components",
    "build": "node scripts/build-cloudflare-pages.mjs",
    "render:social": "node scripts/render-social-image.mjs",
    "render:figures": "node scripts/render-doc-figures.mjs",
    "lint:html": "html-validate dist/index.html dist/404.html \"dist/examples/*.html\"",
    "lint:types": "tsc --noEmit --strict --target es2022 --module nodenext --moduleResolution nodenext --allowImportingTsExtensions --lib es2022,dom tests/types/check.ts",
    "test": "npm run build && npm run lint:html && npm run lint:types && playwright test",
    "deploy": "npm run build && npx wrangler pages deploy",
    "dev": "npm run build && serve dist -l 3456",
    "preview": "npm run build && serve dist -l 3456"
  },
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "axe-core": "4.10.3",
    "html-validate": "11.16.0",
    "serve": "^14.2.6",
    "typescript": "5.9.3"
  },
  "types": "./components/membrane.d.ts"
}
